{
  "manifest_version": 3,
  "name": "Tabventure",
  "version": "1.3.0",
  "description": "Turn webpage geometry into a keyboard-controlled platforming playground.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tabventure",
    "default_popup": "popup.html"
  }
}
